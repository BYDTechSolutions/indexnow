{
  "name": "@bydtech/indexnow",
  "version": "0.1.1",
  "description": "Tell Bing and the other IndexNow search engines which pages changed, from your sitemap or a list of paths.",
  "keywords": [
    "indexnow",
    "seo",
    "sitemap",
    "bing",
    "yandex",
    "search-engine",
    "cli"
  ],
  "homepage": "https://github.com/BYDTechSolutions/indexnow#readme",
  "bugs": {
    "url": "https://github.com/BYDTechSolutions/indexnow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BYDTechSolutions/indexnow.git"
  },
  "license": "MIT",
  "author": "BYD Tech <sales.bydtech@gmail.com> (https://bydtech.in)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "indexnow": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
